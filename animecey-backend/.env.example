# AnimeCey Backend — Environment Variables
# Copy to .env and fill in your values

# ── Database ───────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./animecey.db

# ── JWT ────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Telegram Bot ───────────────────────────────────────
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_ADMIN_IDS=123456789

# ── Byse.sx (Filemoon) ────────────────────────────────
BYSE_API_KEY=your_byse_api_key

# ── TMDB ───────────────────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key

# ── AniList ────────────────────────────────────────────
ANILIST_BASE_URL=https://graphql.anilist.co

# ── Web Push (VAPID) ──────────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_CLAIMS_EMAIL=mailto:admin@animecey.com

# ── CORS ───────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://animecey.vercel.app
